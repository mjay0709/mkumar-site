---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Experience | MK">

  <Navbar />

  <main class="mx-auto max-w-5xl px-6 py-24">

    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">
      Experience
    </p>

    <h1 class="text-5xl font-bold tracking-tight">
      Building growth systems for B2B SaaS.
    </h1>

    <div class="mt-16 space-y-16">

      <section>
        <h2 class="text-2xl font-semibold">Bellwether</h2>
        <p class="mt-4 text-gray-600">
          Built and scaled the marketing function across SEO, paid media,
          content, website, email and product marketing for an enterprise
          procurement platform.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">Embrace Software</h2>
        <p class="mt-4 text-gray-600">
          Focused on product marketing, content strategy and demand generation
          across multiple B2B software businesses.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">Today</h2>
        <p class="mt-4 text-gray-600">
          Building CRM, Automation & GTM Systems using Salesforce, n8n,
          PostgreSQL and AI.
        </p>
      </section>

    </div>

  </main>

</Layout>