---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Revenue Operating System">

<Navbar />

<main class="mx-auto max-w-5xl px-6 py-24">

<p class="text-sm uppercase tracking-[0.2em] text-blue-600">
Featured Lab
</p>

<h1 class="mt-4 text-5xl font-bold">
Revenue Operating System
</h1>

<p class="mt-8 text-xl text-gray-600">
A production-style GTM stack built using Salesforce, n8n,
PostgreSQL, PostHog, Slack and AI.
</p>

<h2 class="mt-20 text-3xl font-semibold">
Architecture
</h2>

<pre class="mt-8 rounded-xl border bg-gray-50 p-8">

Website

↓

Lead Form

↓

Webhook

↓

n8n

├── Salesforce

├── PostgreSQL

├── Slack

├── AI

└── PostHog

↓

Dashboard

</pre>

</main>

<Footer />

</Layout>