---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Labs | MK">

<Navbar />

<main class="mx-auto max-w-6xl px-6 py-24">

<p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">
Labs
</p>

<h1 class="text-5xl font-bold">
Projects I'm Building
</h1>

<div class="mt-16 grid gap-8 md:grid-cols-2">

<div class="rounded-xl border p-8">

<h2 class="text-2xl font-semibold">
Revenue Operating System
</h2>

<p class="mt-4 text-gray-600">
End-to-end GTM platform integrating website, Salesforce,
automation, SQL, analytics and AI.
</p>

<p class="mt-8 font-medium text-blue-600">
<a
  href="/labs/revenue-operating-system"
  class="mt-8 inline-block font-semibold text-blue-600"
>
Explore →
</a>
</p>

</div>

<div class="rounded-xl border p-8 opacity-60">

<h2 class="text-2xl font-semibold">
AI SDR
</h2>

<p class="mt-4 text-gray-600">
Coming Soon
</p>

</div>

<div class="rounded-xl border p-8 opacity-60">

<h2 class="text-2xl font-semibold">
SEO Intelligence
</h2>

<p class="mt-4 text-gray-600">
Coming Soon
</p>

</div>

<div class="rounded-xl border p-8 opacity-60">

<h2 class="text-2xl font-semibold">
Content Engine
</h2>

<p class="mt-4 text-gray-600">
Coming Soon
</p>

</div>

</div>

</main>

</Layout>