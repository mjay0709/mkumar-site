---
import Layout from "../layouts/Layout.astro";

---
<Layout title="Book a Demo | MK">

  <main class="mx-auto max-w-3xl px-6 py-24">

    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">
      Revenue Operating System
    </p>

    <h1 class="mt-4 text-5xl font-bold tracking-tight">
      Book a Demo
    </h1>

    <p class="mt-6 text-lg text-gray-600">
      This demo request powers the entire Revenue Operating System—from lead capture to CRM, automation, analytics and AI.
    </p>

    <form
      id="demoForm"
      class="mt-16 space-y-6"
    >

      <div>
        <label for="firstName" class="mb-2 block font-medium">
          First Name
        </label>

        <input
          id="firstName"
          name="firstName"
          type="text"
          required
          class="w-full rounded-lg border border-gray-300 px-4 py-3"
        />
      </div>

      <div>
        <label for="lastName" class="mb-2 block font-medium">
          Last Name
        </label>

        <input
          id="lastName"
          name="lastName"
          type="text"
          required
          class="w-full rounded-lg border border-gray-300 px-4 py-3"
        />
      </div>

      <div>
        <label for="email" class="mb-2 block font-medium">
          Work Email
        </label>

        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-gray-300 px-4 py-3"
        />
      </div>

      <div>
        <label for="company" class="mb-2 block font-medium">
          Company
        </label>

        <input
          id="company"
          name="company"
          type="text"
          required
          class="w-full rounded-lg border border-gray-300 px-4 py-3"
        />
      </div>

      <div>
        <label for="jobTitle" class="mb-2 block font-medium">
          Job Title
        </label>

        <input
          id="jobTitle"
          name="jobTitle"
          type="text"
          class="w-full rounded-lg border border-gray-300 px-4 py-3"
        />
      </div>

      <div>
        <label for="crm" class="mb-2 block font-medium">
          Current CRM
        </label>

        <select
          id="crm"
          name="crm"
          class="w-full rounded-lg border border-gray-300 px-4 py-3"
        >
          <option value="">Select one</option>
          <option>Salesforce</option>
          <option>HubSpot</option>
          <option>Dynamics</option>
          <option>Pipedrive</option>
          <option>None</option>
        </select>
      </div>

      <div>
        <label for="challenge" class="mb-2 block font-medium">
          Biggest GTM Challenge
        </label>

        <textarea
          id="challenge"
          name="challenge"
          rows="5"
          class="w-full rounded-lg border border-gray-300 px-4 py-3"
        ></textarea>
      </div>

      <button
        type="submit"
        class="rounded-lg bg-black px-8 py-3 text-white transition hover:bg-gray-800"
      >
        Book Demo
      </button>

    </form>

  </main>
<script>
import posthog from "posthog-js";
  const form = document.getElementById("demoForm");

let formStarted = false;

form?.addEventListener("focusin", () => {
  if (formStarted) return;

  formStarted = true;

  console.log("Form started");

  posthog.capture("demo_form_started");
});

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const formData = new FormData(form);

    const payload = Object.fromEntries(formData.entries());
    posthog.capture("demo_submitted", {
  company: payload.company,
  crm: payload.crm,
  job_title: payload.jobTitle
});

    try {
      const response = await fetch(
        "https://sperm-dallas-wed-garmin.trycloudflare.com/webhook-test/book-demo",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        }
      );

      if (response.ok) {
        posthog.identify(payload.email, {
  name: `${payload.firstName} ${payload.lastName}`,
  company: payload.company,
  crm: payload.crm,
  job_title: payload.jobTitle,
});
posthog.capture("demo_submitted", {
  company: payload.company,
  crm: payload.crm,
  job_title: payload.jobTitle,
});
        alert("Demo request received by n8n!");
        form.reset();
      } else {
        alert("Something went wrong.");
      }
    } catch (error) {
      console.error(error);
      alert("Could not connect to n8n.");
    }
  });
</script>
</Layout>