import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../scripts/posthog";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "MK | Growth & Marketing Operations",
	description = "Building CRM, Automation & GTM Systems for B2B SaaS."
} = Astro.props;
---


